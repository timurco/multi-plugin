#include "multiplugin/core/version.hpp"
#include <cstdio>  // for snprintf

namespace mp {

// Version definition - only place that needs recompilation
static constexpr Version kPluginVersion = {
    .major = @MP_VERSION_MAJOR@,
    .minor = @MP_VERSION_MINOR@,
    .patch = @MP_VERSION_PATCH@,
    .stage = @MP_VERSION_STAGE@,
    .build = @MP_VERSION_BUILD@
};

const Version& getPluginVersion() {
    return kPluginVersion;
}

const char* getPluginVersionString() {
    static char versionStr[64];
    static bool initialized = false;

    if (!initialized) {
        // Format: "major.minor.patch build buildNumber"
        // Example: "0.1.2 build 45"
        snprintf(versionStr, sizeof(versionStr), "%d.%d.%d build %d",
                kPluginVersion.major,
                kPluginVersion.minor,
                kPluginVersion.patch,
                kPluginVersion.build);
        initialized = true;
    }

    return versionStr;
}

// AE version function - replicates PF_VERSION macro logic
uint32_t getAEVersion() {
    // Bit layout for AE version:
    // Build:   bits 0-8    (9 bits, max 511)
    // Stage:   bits 9-10   (2 bits, max 3)
    // Bugfix:  bits 11-14  (4 bits, max 15)
    // Subvers: bits 15-18  (4 bits, max 15)
    // Vers:    bits 19-21  (3 bits low)
    // VersHi:  bits 26-29  (4 bits high)

    const uint32_t PF_Vers_BUILD_BITS   = 0x1ff;
    const uint32_t PF_Vers_BUILD_SHIFT  = 0;
    const uint32_t PF_Vers_STAGE_BITS   = 0x3;
    const uint32_t PF_Vers_STAGE_SHIFT  = 9;
    const uint32_t PF_Vers_BUGFIX_BITS  = 0xf;
    const uint32_t PF_Vers_BUGFIX_SHIFT = 11;
    const uint32_t PF_Vers_SUBVERS_BITS = 0xf;
    const uint32_t PF_Vers_SUBVERS_SHIFT = 15;
    const uint32_t PF_Vers_VERS_BITS    = 0x7;
    const uint32_t PF_Vers_VERS_SHIFT   = 19;
    const uint32_t PF_Vers_VERS_HIGH_BITS = 0xf;
    const uint32_t PF_Vers_VERS_HIGH_SHIFT = 26;
    const uint32_t PF_Vers_VERS_LOW_SHIFT = 3;

    // Split major version into high and low parts
    uint32_t vers_high = kPluginVersion.major >> PF_Vers_VERS_LOW_SHIFT;

    return ((vers_high & PF_Vers_VERS_HIGH_BITS) << PF_Vers_VERS_HIGH_SHIFT) |
           ((kPluginVersion.major & PF_Vers_VERS_BITS) << PF_Vers_VERS_SHIFT) |
           ((kPluginVersion.minor & PF_Vers_SUBVERS_BITS) << PF_Vers_SUBVERS_SHIFT) |
           ((kPluginVersion.patch & PF_Vers_BUGFIX_BITS) << PF_Vers_BUGFIX_SHIFT) |
           ((kPluginVersion.stage & PF_Vers_STAGE_BITS) << PF_Vers_STAGE_SHIFT) |
           ((kPluginVersion.build & PF_Vers_BUILD_BITS) << PF_Vers_BUILD_SHIFT);
}

} // namespace mp